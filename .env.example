# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/campuscast?schema=public"

# Redis Connection (BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth Secret
NEXTAUTH_SECRET="campuscast_super_secret_auth_key_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# AWS & CloudFront (Optional in Dev - Mocked if credentials missing)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="mock_aws_access_key"
AWS_SECRET_ACCESS_KEY="mock_aws_secret_key"
AWS_S3_BUCKET="campuscast-posters"
AWS_CLOUDFRONT_DOMAIN="https://d1111111111111.cloudfront.net"
AWS_IOT_ENDPOINT="a3xxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"

# Job Schedules
BROADCAST_JOB_INTERVAL_HOURS="2"
REMINDER_JOB_INTERVAL_HOURS="4"
