# Database URL (Default: local SQLite database)
# For local development:
DATABASE_URL="file:./dev.db"

# For free PostgreSQL hosting (Neon / Supabase / Render):
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Optional Cloud Storage for Free Serverless Deployment (Cloudinary):
# If set, uploaded poster images will automatically save to Cloudinary free storage.
# If omitted, local disk (/public/uploads) is used locally, or Base64 data URLs in serverless.
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_UPLOAD_PRESET="your_unsigned_upload_preset"

# Application Port
PORT=3000
