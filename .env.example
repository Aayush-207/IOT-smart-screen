NODE_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgresql://campuscast:campuscast@localhost:5432/campuscast
REDIS_URL=redis://localhost:6379

AWS_REGION=ap-south-1
S3_QUARANTINE_BUCKET=campuscast-development-quarantine
TELEMETRY_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/campuscast-telemetry

COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_example
COGNITO_CLIENT_ID=replace-me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

OUTBOX_QUEUE_NAME=campuscast-events
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
SQS_WAIT_SECONDS=20
SQS_BATCH_SIZE=10
