# ── Required ──────────────────────────────────────────────────────────────
# Supabase project credentials (Project Settings -> API in the dashboard).
# The app will not build/run without these.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Server-only, optional ─────────────────────────────────────────────────
# Powers the scheduled expiry job (GET /api/cron/expire) and persisting the
# advisory-moderation result onto the announcement. The service-role key
# bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Shared secret the expiry cron checks: request must send
# `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sends this automatically.
CRON_SECRET=""

# Enables the advisory AI moderation note on the approval screen
# (blueprint Part 22). If unset, only the deterministic checks run — the
# workflow is identical either way.
ANTHROPIC_API_KEY=""
