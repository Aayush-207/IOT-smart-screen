@startuml
left to right direction
skinparam backgroundColor #0a0a0a
skinparam fontColor #f5f5f5
skinparam fontSize 12
skinparam fontName Inter

title CampusCast IoT Smart Screen Architecture & Fleet Flow

package "University Campus Edge Locations" {
  rectangle "Tech Block A (Central Foyer)" {
    mxgraph.aws4.iot_thing_industrial_pc "Kiosk Display 01\n(Android 14 DPC)" as kiosk1
    mxgraph.aws4.sensor "Temp/Thermal\nSensor" as sensor1
  }

  rectangle "Central Library (Study Atrium)" {
    mxgraph.aws4.iot_thing_industrial_pc "Kiosk Display 02\n(ExoPlayer / Room DB)" as kiosk2
  }

  rectangle "Grand Dome Auditorium" {
    mxgraph.aws4.iot_thing_industrial_pc "Kiosk Display 03\n(Emergency Receiver)" as kiosk3
  }
}

package "AWS Cloud Infrastructure (ap-south-1 Mumbai)" {
  rectangle "AWS IoT Ecosystem" {
    mxgraph.aws4.iot_core "AWS IoT Core\n(MQTT Broker)" as iot_core
    mxgraph.aws4.iot_device_gateway "X.509 Mutual TLS\nGateway" as gateway
    mxgraph.aws4.iot_device_management "IoT Named Shadow\nReconciliation" as shadow
    mxgraph.aws4.iot_over_the_air_update "AWS OTA Jobs\n(Firmware / DPC)" as ota
  }

  rectangle "Ingest & Content Pipeline" {
    mxgraph.aws4.s3 "S3 Quarantine\nBucket" as quarantine_s3
    mxgraph.aws4.s3 "S3 Approved CDN\nBucket" as cdn_s3
  }

  rectangle "Control Plane (Modular Monolith)" {
    mxgraph.aws4.generic_database "PostgreSQL DB\n(org_id Scoped)" as postgres
    mxgraph.aws4.ec2 "Express API\n(Port 8080)" as api
    mxgraph.aws4.ec2 "BullMQ Worker\n(Media & Manifest)" as worker
    mxgraph.aws4.ecr "Dashboard Client\n(Next.js / Vite)" as web_ui
  }
}

' Connectivity & Flows
sensor1 --> kiosk1 : Local Sensor Data
kiosk1 ..> gateway : MQTT / TLS v1.3\n(Heartbeat & Telemetry)
kiosk2 ..> gateway : MQTT / TLS v1.3
kiosk3 ..> gateway : MQTT / TLS v1.3

gateway --> iot_core
iot_core --> shadow : Sync State
shadow ..> kiosk1 : Manifest Push\n($aws/things/id/shadow)

web_ui --> api : HTTPS / Cognito JWT
api --> postgres : Multi-Tenant Queries
api --> quarantine_s3 : S3 Presigned URL

quarantine_s3 ..> worker : S3 Object Created Event
worker --> cdn_s3 : Promote Clean Asset
worker --> shadow : Re-compile Manifest

cdn_s3 ..> kiosk1 : HTTPS CDN Media Download\n(Offline Room DB Cache)
cdn_s3 ..> kiosk2 : HTTPS CDN Media Download
ota ..> kiosk1 : Remote App Update
@enduml
