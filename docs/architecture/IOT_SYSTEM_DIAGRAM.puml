@startuml CampusCast_Simple_Architecture
left to right direction
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Inter
skinparam defaultFontSize 14
skinparam ArrowColor #2563EB
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #0F274A
  FontColor #0F274A
  RoundCorner 18
}

title CampusCast - Simple System Flow

rectangle "1. Upload\nClub or college adds a poster" as author
rectangle "2. Review & schedule\nAdmin approves when and where it plays" as cloud
mxgraph.aws4.iot_core "3. Secure delivery\nAWS IoT Core sends the update" as iot
rectangle "4. Campus screens\nKiosk app plays from local cache" as screens

author --> cloud : HTTPS
cloud --> iot : approved schedule
iot --> screens : update + media link
screens ..> cloud : heartbeat / status

@enduml
