{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.campuscast.example/device/manifest/v1.json",
  "title": "CampusCast Device Playback Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "manifestVersion",
    "thingName",
    "generatedAt",
    "validFrom",
    "scheduleRevisionIds",
    "playlist",
    "playbackPolicy",
    "compatibility",
    "correlationId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "$ref": "#/$defs/uuid"
    },
    "manifestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "thingName": {
      "$ref": "#/$defs/thingName"
    },
    "generatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "validFrom": {
      "$ref": "#/$defs/timestamp"
    },
    "validUntil": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "fallbackManifestId": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "scheduleRevisionIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "playlist": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/playlistItem"
      }
    },
    "playbackPolicy": {
      "$ref": "#/$defs/playbackPolicy"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "thingName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "byteLength",
        "sha256",
        "mimeType",
        "download"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/uuid"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "video/mp4"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "download": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "expiresAt"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "expiresAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      }
    },
    "playlistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "contentItemId",
        "contentVersionId",
        "mediaType",
        "durationMs",
        "hardExpiresAt",
        "asset"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/uuid"
        },
        "contentItemId": {
          "$ref": "#/$defs/uuid"
        },
        "contentVersionId": {
          "$ref": "#/$defs/uuid"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "IMAGE",
            "VIDEO"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "hardExpiresAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "playbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop",
        "defaultSlateAssetId",
        "maxClockSkewMs"
      ],
      "properties": {
        "loop": {
          "type": "boolean"
        },
        "defaultSlateAssetId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxClockSkewMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "transition": {
          "type": "string",
          "enum": [
            "NONE",
            "FADE"
          ],
          "default": "NONE"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumAppVersionCode",
        "mediaTypes"
      ],
      "properties": {
        "minimumAppVersionCode": {
          "type": "integer",
          "minimum": 1
        },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "IMAGE",
              "VIDEO"
            ]
          }
        }
      }
    }
  }
}
