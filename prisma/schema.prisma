datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Club {
  id           String   @id @default(cuid())
  name         String
  hodUserId    String?  // nullable — null means this club skips HOD approval
  departmentId String
  events       Event[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         String   // "club_president" | "club_hod" | "admin" | "viewer"
  clubId       String?
  departmentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id           String        @id @default(cuid())
  clubId       String
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title        String
  eventDate    DateTime
  venue        String
  contentItems ContentItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ContentItem {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mediaUrl      String
  selfCertified Boolean          @default(false)
  status        String           @default("awaiting_poster") // awaiting_poster, pending_hod_approval, pending_admin_approval, approved, rejected, ineligible, live, archived
  submittedById String
  approvedById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  approvalSteps ApprovalStep[]
  versions      ContentVersion[]
  schedules     Schedule[]
}

model ContentVersion {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  mediaUrl      String
  createdAt     DateTime    @default(now())
}

model ApprovalStep {
  id             String      @id @default(cuid())
  contentItemId  String
  contentItem    ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  approverUserId String?
  approverRole   String
  decision       String      // "approve" | "reject" | "override" | "system_ineligible"
  comment        String?
  createdAt      DateTime    @default(now())
}

model Device {
  id              String     @id @default(cuid())
  locationTag     String
  zone            String
  status          String     // "online" | "offline"
  lastHeartbeat   DateTime?
  firmwareVersion String?
  schedules       Schedule[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Schedule {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startAt       DateTime
  endAt         DateTime
  createdAt     DateTime    @default(now())
}

model DeviceLog {
  id        String   @id @default(cuid())
  deviceId  String
  eventType String   // "heartbeat" | "failover" | "ota_result"
  payload   String   // JSON stringified payload
  createdAt DateTime @default(now())
}

model JobRun {
  id            String    @id @default(cuid())
  jobName       String
  status        String    // "success" | "failed" | "running"
  rowsProcessed Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  error         String?
}
